<!-- START : carousel -->
<section>
  <div class="container-fluid container-fluid-baniere ">
    <div id="myCarousel" class="carousel slide" data-ride="carousel">
      <ol class="carousel-indicators">
        {% for item in carousel.children %}
          <li data-target="#myCarousel"
                  data-slide-to="{{ loop.index0 }}"
                  class="{{ loop.first ? 'active' : '' }}"></li>
        {% endfor %}
      </ol>
      <div class="carousel-inner">
        {% for item in carousel.children %}
        <div class="carousel-item {{ loop.first ? 'active' : '' }}">
        <img src="{{ asset(item.extras.image) }}" class="d-block w-100" alt="{{ item.label }}">
        <div class=" d-md-block carousel-caption skw-caption text-right  d-none d-lg-block">
          <h5  class=" title-baniere text-uppercase" style="text-align: right">{{ item.label }}</h5>
          {% if item.extras.description %}
            <p class=" d-xs-none text-baniere" style="text-align: right; font-size: 19px" >{{ item.extras.description }}</p>
          {% endif %}
          <p class="mb-0 pb-0">
            <a class="btn btn-sm btn-warning btn-baniere" style="float: left" href="{{ item.extras.link }}" role="button">إقرأ المزيد...  </a>
          </p>
        </div>
      </div>
      {% endfor %}



      </div>
      <a class="carousel-control-prev" href="#myCarousel" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
      </a>
      <a class="carousel-control-next" href="#myCarousel" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
      </a>
    </div>
  </div>
</section>
<style>
  .carousel-caption{
    position: absolute;
    right: 10%;
    bottom: 150px!important;
    left: 15%;
    z-index: 10;
    padding-top: 20px;
    padding-bottom: 20px;
    color: #fff;
    font-size: 25px!important;
  }
  .carousel-indicators li{
    box-sizing: content-box;
    flex: 0 1 auto;
    width: 25px;
    height: 25px;
    margin-right: 3px;
    margin-left: 3px;
    cursor: pointer;
    /* background-color: #fff; */
    background-clip: padding-box;
    opacity: 1;
    transition: opacity 0.6s ease;
    border: 1px solid orange;
    /* border: 2px solid orange; */
    border-radius: 20px;
    background-color: rgb(255, 255, 255);
    /* background-color: rgb(5, 1, 214); */
    margin-top: 5px;
    margin-bottom: 5px;
    z-index: 20;

  }
</style>
<!-- END : carousel -->
