{# templates/back/content/_form.html.twig #}
{% trans_default_domain 'forms' %}
{% form_theme form 'bootstrap_4_layout.html.twig' %}

{% set scope = app.session.get('current_scope') %}
{% set back_href = back_href is defined
    ? back_href
    : (scope ? path('app_content_index', {'scope': scope.id}) : path('app_content_index')) %}

{{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

<div class="action-bar sticky-top py-2 mb-3 bg-white border-bottom d-flex justify-content-between align-items-center">
    <a href="{{ back_href }}" class="btn btn-light btn-sm">{{ 'form.actions.back'|trans }}</a>
    <div>
        <button type="submit" name="save" class="btn btn-primary btn-sm">
            {{'form.actions.save'|trans }}
        </button>
        {% if is_edit is not defined or not is_edit %}
            <button type="submit" name="save_continue" value="1" class="btn btn-outline-primary btn-sm">
                {{ 'form.actions.save_continue'|trans }}
            </button>
        {% endif %}
    </div>
</div>

{{ form_errors(form) }}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header"><strong>{{ 'form.sections.main'|trans }}</strong></div>
            <div class="card-body">
                {{ form_row(form.title) }}
                {{ form_row(form.intro) }}
                {{ form_row(form.body) }}

                {% if scope and scope.id == 15 %}
                    <div class="mt-2">
                        <a class="btn btn-sm btn-secondary" href="#" id="load_gallery">{{ 'Charger une galerie'|trans }}</a>
                        <input type="hidden" id="content_scope" value="{{ scope.id }}">
                        <input type="hidden" id="content_id" value="{{ content.id }}">
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>{{ 'form.sections.tags'|trans }}</strong></div>
            <div class="card-body">
                {{ form_row(form.tags) }}
            </div>
        </div>
        <div class="card mb-3" id="quick-uploader" data-upload-url="{{ path('ck_upload') }}">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>{{ 'form.attachments.quick.title'|trans }}</strong>
                <span class="small text-muted">{{ 'form.attachments.quick.autocopy'|trans }}</span>
            </div>

            <div class="card-body">
                <div class="d-flex align-items-center flex-wrap" style="gap:.5rem">
                    {# Le label ouvre le file input même si JS n’est pas chargé #}
                    <label for="inputUpload" class="btn btn-sm btn-outline-secondary mb-0" id="btnUpload">
                        {{ 'form.attachments.quick.btn.upload'|trans }}
                    </label>

                    <input type="file"
                           id="inputUpload"
                           class="visually-hidden"
                           accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.zip,.rar,.txt"/>

                    <div id="uploadProgress" class="progress d-none" style="min-width:220px; width:320px;">
                        <div class="progress-bar" role="progressbar" style="width:0%"></div>
                    </div>

                    <span id="uploadStatus" class="small text-muted"></span>
                </div>

                <div id="uploadedPathWrap" class="mt-3 d-none">
                    <label class="small text-muted mb-1">{{ 'form.attachments.quick.partial_path'|trans }}</label>
                    <div class="input-group">
                        <input type="text" class="form-control form-control-sm" id="uploadedPath" readonly>
                        <button class="btn btn-sm btn-outline-primary" id="btnCopy" type="button">
                            {{ 'form.attachments.quick.btn.copy'|trans }}
                        </button>
                        <button class="btn btn-sm btn-outline-success" id="btnInsert" type="button"
                                title="{{ 'form.attachments.quick.btn.insert_title'|trans }}">
                            {{ 'form.attachments.quick.btn.insert'|trans }}
                        </button>
                    </div>
                    <div class="small text-muted mt-1" id="uploadTips">{{ 'form.attachments.quick.hint'|trans }}</div>
                </div>
            </div>
        </div>

    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><strong>{{ 'form.sections.scope'|trans }}</strong></div>
            <div class="card-body">
                {{ form_row(form.scope) }}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>{{ 'form.sections.publish'|trans }}</strong></div>
            <div class="card-body">
                {{ form_row(form.published_date) }}
                {{ form_row(form.fullWidth) }}
                {{ form_row(form.published) }}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>{{ 'form.sections.picture'|trans }}</strong></div>
            <div class="card-body">
                {{ form_widget(form.picture) }}
                {% if content.picture %}
                    <div class="mt-3 text-center">
                        <img src="{{ asset('uploads/' ~ content.picture) }}" alt="" class="img-fluid rounded border">
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="action-bar py-3 mt-3 bg-white border-top d-flex justify-content-between align-items-center">
    <a href="{{ back_href }}" class="btn btn-light">{{ 'form.actions.back'|trans }}</a>
    <div>
        <button type="submit" name="save" class="btn btn-primary">
            {{ 'form.actions.save'|trans }}
        </button>
        {% if is_edit is not defined or not is_edit %}
            <button type="submit" name="save_continue" value="1" class="btn btn-outline-primary">
                {{ 'form.actions.save_continue'|trans }}
            </button>
        {% endif %}
    </div>
</div>

{{ form_end(form) }}
